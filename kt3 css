body {
  background: #f5efe6;
  margin: 0;
  padding: 20px;
}

header {
  text-align: center;
  font-family: Montserrat, sans-serif;
  font-size: 18px;
  margin-bottom: 20px;
}

.title {
  text-align: center;
  font-family: "Playfair Display", serif;
  font-size: 40px;
  color: #4b2e2e;
}

.container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #6f4e37;
  border-radius: 15px;
  padding: 20px;
  margin-bottom: 30px;
}

.container1 {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
  background: #3e2723;
  border-radius: 15px;
  padding: 20px;
}

.item {
  height: 140px;
  padding: 20px;
  border-radius: 12px;
  text-align: center;
  font-family: Montserrat, sans-serif;
  color: #2b1b1b;
}

.item1 { background: #d7b899; }
.item2 { background: #cfa77d; }
.item3 { background: #b68d63; }
.item4 { background: #a47148; }
.item5 { background: #8b5a2b; }

.item6 { background: #f2d0a7; }
.item7 { background: #e6b980; }
.item8 { background: #d2a679; }
.item9 { background: #bf8f68; }
.item0 { background: #a97142; }

footer {
  text-align: center;
  margin-top: 30px;
  font-family: "Playfair Display", serif;
  font-size: 20px;
}
